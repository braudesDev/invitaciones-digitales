.formulario-container {
  max-width: 900px;
  margin: 0 auto;
  padding: 20px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
}

.title {
  text-align: center;
  color: #333;
  margin-bottom: 24px;
}

/* TABS */
.tabs {
  display: flex;
  gap: 8px;
  border-bottom: 2px solid #e0e0e0;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.tabs button {
  padding: 12px 24px;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 16px;
  border-radius: 8px 8px 0 0;
  transition: all 0.3s;
}

.tabs button:hover {
  background: #f5f5f5;
}

.tabs button.active {
  background: #aef9b3;
  color: #000;
  font-weight: bold;
}

/* Tab content */
.tab-content {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.tab-content h3 {
  color: #555;
  margin-bottom: 20px;
  padding-bottom: 8px;
  border-bottom: 2px solid #aef9b3;
}

/* Campos */
.campo {
  margin-bottom: 20px;
}

.campo label {
  display: block;
  font-weight: 600;
  margin-bottom: 8px;
  color: #333;
}

.campo input,
.campo select,
.campo textarea {
  width: 100%;
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 14px;
  box-sizing: border-box;
}

.campo textarea {
  resize: vertical;
  font-family: inherit;
}

/* Color input */
.color-input {
  display: flex;
  gap: 10px;
  align-items: center;
}

.color-input input[type="color"] {
  width: 50px;
  height: 50px;
  padding: 2px;
  cursor: pointer;
}

.color-input input[type="text"] {
  flex: 1;
}

/* Image input */
.image-input {
  display: flex;
  gap: 10px;
}

.image-input input[type="text"] {
  flex: 3;
}

.image-input input[type="file"] {
  flex: 1;
  padding: 8px;
}

.preview {
  margin-top: 10px;
}

.preview img {
  border-radius: 8px;
  border: 1px solid #ddd;
}

/* Subsecciones */
.subseccion {
  background: #f9f9f9;
  padding: 15px;
  border-radius: 12px;
  margin-bottom: 20px;
}

.subseccion h4 {
  margin-top: 0;
  margin-bottom: 15px;
  color: #555;
}

.subseccion input,
.subseccion textarea {
  width: 100%;
  padding: 8px;
  margin-bottom: 10px;
  border: 1px solid #ddd;
  border-radius: 6px;
  box-sizing: border-box;
}

.subseccion button {
  background: #ff6b6b;
  color: white;
  border: none;
  padding: 5px 10px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 12px;
}

.subseccion button[type="button"]:not(:last-child) {
  background: #4caf50;
  margin-right: 5px;
}

/* Botones de acción */
.acciones {
  margin-top: 30px;
  text-align: center;
}

.btn-guardar {
  background: linear-gradient(135deg, #aef9b3, #7e57c2);
  color: white;
  border: none;
  padding: 14px 40px;
  font-size: 18px;
  font-weight: bold;
  border-radius: 40px;
  cursor: pointer;
  transition: transform 0.2s;
}

.btn-guardar:hover {
  transform: scale(1.02);
}

.btn-guardar:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* Estilos para galería de fotos */
.campo-foto {
  display: flex;
  gap: 10px;
  margin-bottom: 10px;
  align-items: center;
}

.foto-input {
  flex: 1;
}

.btn-eliminar-foto {
  background: #ff4444;
  color: white;
  border: none;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 16px;
}

.btn-eliminar-foto:hover {
  background: #cc0000;
}

.btn-agregar {
  background: #4caf50;
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 8px;
  cursor: pointer;
  margin-top: 10px;
  font-weight: 500;
}

.btn-agregar:hover {
  background: #45a049;
}

.preview-fotos {
  margin-top: 20px;
  padding: 15px;
  background: #f5f5f5;
  border-radius: 12px;
}

.preview-fotos p {
  margin: 0 0 10px 0;
  font-weight: 500;
  color: #555;
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 10px;
}

.preview-img {
  width: 100%;
  height: 100px;
  object-fit: cover;
  border-radius: 8px;
  border: 2px solid #ddd;
}

.ayuda {
  font-size: 12px;
  color: #888;
  margin: 5px 0 10px 0;
}
