<div class="formulario-container">
  <h2 class="title">
    {{ invitacionId ? "✏️ Editar invitación" : "✨ Crear nueva invitación" }}
  </h2>

  <div class="tabs">
    <button
      [class.active]="tabActivo === 'basicos'"
      (click)="tabActivo = 'basicos'"
    >
      📋 Básicos
    </button>
    <button
      [class.active]="tabActivo === 'diseno'"
      (click)="tabActivo = 'diseno'"
    >
      🎨 Diseño
    </button>
    <button
      [class.active]="tabActivo === 'mensajes'"
      (click)="tabActivo = 'mensajes'"
    >
      💬 Mensajes
    </button>
    <button
      [class.active]="tabActivo === 'evento'"
      (click)="tabActivo = 'evento'"
    >
      🎊 Evento
    </button>
    <button
      [class.active]="tabActivo === 'secciones'"
      (click)="tabActivo = 'secciones'"
    >
      📑 Secciones
    </button>
  </div>

  <form (ngSubmit)="guardarInvitacion()" #formInvitacion="ngForm">
    <!-- TAB 1: BÁSICOS -->
    <div class="tab-content" *ngIf="tabActivo === 'basicos'">
      <h3>Información principal</h3>
      <div class="campo">
        <label>📌 Nombre del evento *</label>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.name"
          name="name"
          required
        />
      </div>
      <div class="campo">
        <label>🎭 Tipo de evento *</label>
        <select [(ngModel)]="nuevaInvitacion.tipo" name="tipo" required>
          <option value="boda">💍 Boda</option>
          <option value="xv">👗 XV Años</option>
        </select>
      </div>
      <div class="campo">
        <label>👰 Nombres del festejado(s) *</label>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.nombres"
          name="nombres"
          required
        />
      </div>
      <div class="campo">
        <label>📅 Fecha y hora *</label>
        <input
          type="datetime-local"
          [(ngModel)]="nuevaInvitacion.fecha"
          name="fecha"
          required
        />
      </div>
      <div class="campo">
        <label>📍 Lugar *</label>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.lugar"
          name="lugar"
          required
        />
      </div>
    </div>

    <!-- TAB 2: DISEÑO -->
    <div class="tab-content" *ngIf="tabActivo === 'diseno'">
      <h3>Personalización visual</h3>
      <div class="campo">
        <label>🖼️ Imagen principal (URL)</label>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.heroImage"
          name="heroImage"
        />
      </div>
      <div class="campo">
        <label>🎨 Color principal</label>
        <div class="color-input">
          <input
            type="color"
            [(ngModel)]="nuevaInvitacion.primaryColor"
            name="primaryColor"
          />
          <input
            type="text"
            [(ngModel)]="nuevaInvitacion.primaryColor"
            name="primaryColorText"
          />
        </div>
      </div>
      <div class="campo">
        <label>🎨 Color secundario</label>
        <div class="color-input">
          <input
            type="color"
            [(ngModel)]="nuevaInvitacion.secondaryColor"
            name="secondaryColor"
          />
          <input
            type="text"
            [(ngModel)]="nuevaInvitacion.secondaryColor"
            name="secondaryColorText"
          />
        </div>
      </div>
      <div class="campo">
        <label>✍️ Fuente del texto</label>
        <select [(ngModel)]="nuevaInvitacion.fontFamily" name="fontFamily">
          <option value="'Playfair Display', serif">Playfair Display</option>
          <option value="'Great Vibes', cursive">Great Vibes</option>
          <option value="'Dancing Script', cursive">Dancing Script</option>
        </select>
      </div>
    </div>

    <!-- TAB 3: MENSAJES -->
    <div class="tab-content" *ngIf="tabActivo === 'mensajes'">
      <h3>Textos de la invitación</h3>
      <div class="campo">
        <label>💕 Frase principal</label>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.frasePrincipal"
          name="frasePrincipal"
        />
      </div>
      <div class="campo">
        <label>📖 Mensaje principal</label>
        <textarea
          [(ngModel)]="nuevaInvitacion.mensajePrincipal"
          name="mensajePrincipal"
          rows="4"
        ></textarea>
      </div>
      <div class="campo">
        <label>📚 Historia</label>
        <textarea
          [(ngModel)]="nuevaInvitacion.historia"
          name="historia"
          rows="5"
        ></textarea>
      </div>
    </div>

    <!-- TAB 4: EVENTO -->
    <div class="tab-content" *ngIf="tabActivo === 'evento'">
      <h3>Detalles del evento</h3>
      <div class="subseccion">
        <h4>⛪ Ceremonia</h4>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.ceremonia.lugar"
          name="ceremoniaLugar"
          placeholder="Lugar"
        />
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.ceremonia.direccion"
          name="ceremoniaDireccion"
          placeholder="Dirección"
        />
        <input
          type="time"
          [(ngModel)]="nuevaInvitacion.ceremonia.hora"
          name="ceremoniaHora"
        />
      </div>
      <div class="subseccion">
        <h4>🎉 Recepción</h4>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.recepcion.lugar"
          name="recepcionLugar"
          placeholder="Lugar"
        />
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.recepcion.direccion"
          name="recepcionDireccion"
          placeholder="Dirección"
        />
        <input
          type="time"
          [(ngModel)]="nuevaInvitacion.recepcion.hora"
          name="recepcionHora"
        />
      </div>
      <div class="subseccion">
        <h4>👗 Dress Code</h4>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.dressCode.descripcion"
          name="dressCodeDesc"
          placeholder="Descripción"
        />
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.dressCode.sugerencia"
          name="dressCodeSug"
          placeholder="Sugerencia"
        />
      </div>
    </div>

    <!-- TAB 5: SECCIONES EXTRA -->
    <div class="tab-content" *ngIf="tabActivo === 'secciones'">
      <h3>Secciones adicionales</h3>

      <div class="subseccion">
        <h4>👪 Padres</h4>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.padres.padreNovia"
          name="padreNovia"
          placeholder="Padre de la novia"
        />
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.padres.madreNovia"
          name="madreNovia"
          placeholder="Madre de la novia"
        />
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.padres.padreNovio"
          name="padreNovio"
          placeholder="Padre del novio"
        />
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.padres.madreNovio"
          name="madreNovio"
          placeholder="Madre del novio"
        />
      </div>

      <div class="subseccion">
        <h4>👑 Padrinos</h4>
        <div *ngFor="let padrino of nuevaInvitacion.padrinos; let i = index">
          <input
            type="text"
            [(ngModel)]="nuevaInvitacion.padrinos[i]"
            name="padrino{{ i }}"
            placeholder="Padrino {{ i + 1 }}"
          />
          <button type="button" (click)="eliminarPadrino(i)">❌</button>
        </div>
        <button type="button" (click)="agregarPadrino()">
          + Agregar padrino
        </button>
      </div>

      <div class="subseccion">
        <h4>🎁 Mesa de regalos</h4>
        <textarea
          [(ngModel)]="nuevaInvitacion.regalos.texto"
          name="regalosTexto"
          placeholder="Texto de agradecimiento"
        ></textarea>
        <div *ngFor="let link of nuevaInvitacion.regalos.links; let i = index">
          <input
            type="text"
            [(ngModel)]="link.nombre"
            name="regaloNombre{{ i }}"
            placeholder="Nombre tienda"
          />
          <input
            type="url"
            [(ngModel)]="link.url"
            name="regaloUrl{{ i }}"
            placeholder="URL"
          />
          <button type="button" (click)="eliminarRegaloLink(i)">❌</button>
        </div>
        <button type="button" (click)="agregarRegaloLink()">
          + Agregar tienda
        </button>
      </div>

      <div class="subseccion">
        <h4>✅ Confirmar asistencia</h4>
        <input
          type="tel"
          [(ngModel)]="nuevaInvitacion.confirmacion.telefono"
          name="confirmacionTelefono"
          placeholder="Teléfono"
        />
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.confirmacion.whatsapp"
          name="confirmacionWhatsapp"
          placeholder="WhatsApp"
        />
      </div>

      <div class="subseccion">
        <h4>#️⃣ Hashtag</h4>
        <input
          type="text"
          [(ngModel)]="nuevaInvitacion.hashtag"
          name="hashtag"
          placeholder="#MiBodaFeliz"
        />
      </div>

      <div class="subseccion">
        <h4>📋 Consideraciones</h4>
        <textarea
          [(ngModel)]="nuevaInvitacion.consideraciones"
          name="consideraciones"
          rows="3"
          placeholder="Niños, alergias..."
        ></textarea>
      </div>

      <!-- 📸 SECCIÓN GALERÍA DE FOTOS -->
      <div class="subseccion">
        <h4>📸 Galería de Fotos</h4>
        <p class="ayuda">Agrega URLs de imágenes para mostrar una galería</p>
        <div *ngFor="let foto of nuevaInvitacion.photos; let i = index">
          <div class="campo-foto">
            <input
              type="url"
              [(ngModel)]="nuevaInvitacion.photos[i]"
              name="foto{{ i }}"
              placeholder="URL de la imagen"
              class="foto-input"
            />
            <button
              type="button"
              class="btn-eliminar-foto"
              (click)="eliminarFoto(i)"
            >
              ❌
            </button>
          </div>
        </div>
        <button type="button" class="btn-agregar" (click)="agregarFoto()">
          + Agregar foto
        </button>

        <div class="preview-fotos" *ngIf="nuevaInvitacion.photos.length > 0">
          <p>Vista previa:</p>
          <div class="preview-grid">
            <img
              *ngFor="let foto of nuevaInvitacion.photos; let i = index"
              [src]="foto"
              [alt]="'Foto ' + (i + 1)"
              class="preview-img"
            />
          </div>
        </div>
      </div>
    </div>

    <div class="acciones">
      <button
        type="submit"
        class="btn-guardar"
        [disabled]="!formInvitacion.form.valid"
      >
        💾 Guardar invitación
      </button>
    </div>
  </form>
</div>
