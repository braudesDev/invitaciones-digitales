<div
  *ngIf="data && (data.descripcion || data.sugerencia)"
  class="dresscode-section"
>
  <div class="dresscode-icon">👗</div>
  <h3>Código de Vestimenta</h3>
  <p class="descripcion" *ngIf="data.descripcion">{{ data.descripcion }}</p>
  <div class="sugerencia" *ngIf="data.sugerencia">
    <span class="sugerencia-label">✨ Sugerencia</span>
    <p>{{ data.sugerencia }}</p>
  </div>
</div>
