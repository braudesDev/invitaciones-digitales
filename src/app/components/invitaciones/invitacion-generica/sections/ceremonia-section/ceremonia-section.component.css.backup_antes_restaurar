.ceremonia-section {
  margin: 30px auto;
  padding: 30px 25px;
  max-width: 600px;
  background: white;
  border-radius: 24px;
  text-align: center;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.ceremonia-section:hover {
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
}

.section-icon {
  font-size: 48px;
  margin-bottom: 15px;
}

.ceremonia-section h3 {
  font-size: 1.5rem;
  margin-bottom: 25px;
  color: #2c3e50;
  font-weight: 600;
}

.info-card {
  background: linear-gradient(135deg, #f8f9fa 0%, #f1f3f5 100%);
  border-radius: 20px;
  padding: 20px;
}

.info-item {
  margin-bottom: 15px;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  display: block;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 600;
  color: #7e57c2;
  margin-bottom: 5px;
}

.info-value {
  margin: 0;
  font-size: 1rem;
  color: #333;
  font-weight: 500;
}
